<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Guitar input; USB host so a class-compliant interface (iRig HD X) can
         attach over USB-C. GLES 3.0 is required by JUCE's Android renderer. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Performance guard: lets the app flip Do Not Disturb on while it is
         front-most (user grants via the notification policy settings). -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY"/>
    <!-- BLE MIDI foot controllers (M-Vave Chocolate Plus). A BLE MIDI device
         CANNOT be paired from Android's system Bluetooth settings — an app
         has to scan and call MidiManager.openBluetoothDevice() before the
         MIDI ports exist — so the app needs the scan/connect permissions
         itself. JUCE maps RuntimePermissions::bluetoothMidi to SCAN+CONNECT
         on API 31+, but to ACCESS_FINE_LOCATION on API 30 and below, and
         minSdk here is 29, so BOTH paths must be declared. The legacy
         permissions are capped with maxSdkVersion so Play doesn't treat this
         as a location-tracking app on modern devices. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
                     android:usesPermissionFlags="neverForLocation"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
                     android:maxSdkVersion="30"/>

    <uses-feature android:name="android.hardware.usb.host"/>
    <!-- required=false: a phone without MIDI support still runs the app fine,
         it just can't take a foot controller. -->
    <uses-feature android:name="android.software.midi" android:required="false"/>
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false"/>
    <uses-feature android:glEsVersion="0x00030000" android:required="true"/>

    <!-- android:name=JuceApp is JUCE's Application subclass; it bootstraps the
         native library. hardwareAccelerated=false on the app + true on the
         activity mirrors JUCE's own generated manifest. -->
    <application
        android:label="@string/app_name"
        android:name="com.rmsl.juce.JuceApp"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:hardwareAccelerated="false">

        <receiver android:name="com.rmsl.juce.Receiver" android:exported="false"/>

        <activity
            android:name="com.rmsl.juce.JuceActivity"
            android:label="@string/app_name"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|navigation|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:hardwareAccelerated="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
