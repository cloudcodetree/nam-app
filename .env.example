# TONE3000 API credentials. Copy to .env and fill in your values.
# Publishable key (t3k_pub_...): OAuth2 PKCE client id — safe to embed. Phase 4 uses this.
TONE3000_PUBLISHABLE_KEY=t3k_pub_your_key_here
# Client secret (t3k_cs_...): CONFIDENTIAL/server-side only. A native PKCE client does NOT use it.
TONE3000_CLIENT_SECRET=t3k_cs_your_secret_here

# OpenRouter API key (sk-or-...): LLM gateway, reserved for a future AI feature.
OPENROUTER_API_KEY=sk-or-your-key-here

# Pro-gating dev switch: 0 = develop with all Pro gates/paywall OFF.
# Absent or 1 = gates on (required for any build that ships to testers).
NAM_GATES_ENABLED=1
