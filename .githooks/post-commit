#!/bin/bash
# Auto-push: every commit pushes the current branch to origin in the
# background. The pre-push hook (adversarial review) still gates it; output
# lands in .git/autopush.log. Disable per-commit with NO_AUTOPUSH=1.
set -u

[ "${NO_AUTOPUSH:-0}" = "1" ] && exit 0

branch=$(git symbolic-ref --short -q HEAD) || exit 0   # detached HEAD: skip
log="$(git rev-parse --git-dir)/autopush.log"

{
    echo "=== $(date '+%Y-%m-%d %H:%M:%S') autopush $branch ($(git rev-parse --short HEAD)) ==="
    if git push origin "$branch" 2>&1; then
        echo "[autopush] pushed $branch"
    else
        echo "[autopush] PUSH FAILED for $branch (review block or network — see above)"
    fi
} >> "$log" 2>&1 &

echo "[post-commit] auto-push of $branch started (log: .git/autopush.log)"
