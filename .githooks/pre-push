#!/bin/bash
# Adversarial review gate: every push runs the project's adversarial-reviewer
# agent (headless claude) over the commits being pushed. A BLOCKER finding
# stops the push. Bypass for emergencies: SKIP_REVIEW=1 git push
set -u

[ "${SKIP_REVIEW:-0}" = "1" ] && { echo "[pre-push] SKIP_REVIEW=1 — review skipped"; exit 0; }

zero=0000000000000000000000000000000000000000
status=0

# --- Stage 1: mechanical checks (cheap, deterministic) ---------------------
# clang-format on our own changed sources; the AI review never runs on a
# diff that fails formatting. Tools missing => skip with a note.
TIDY_BIN="/opt/homebrew/opt/llvm/bin/clang-tidy"
if command -v clang-format >/dev/null 2>&1; then
    changed=$(git diff --name-only --diff-filter=ACMR origin/main...HEAD 2>/dev/null \
                | grep -E '^Source/.*\.(cpp|h)$')
    if [ -n "$changed" ]; then
        fmt_bad=""
        for f in $changed; do
            [ -f "$f" ] || continue
            clang-format --dry-run --Werror "$f" >/dev/null 2>&1 || fmt_bad="$fmt_bad $f"
        done
        if [ -n "$fmt_bad" ]; then
            echo "[pre-push] BLOCKED: clang-format violations in:$fmt_bad"
            echo "[pre-push] fix with: clang-format -i$fmt_bad"
            exit 1
        fi
        echo "[pre-push] clang-format clean ($(echo "$changed" | wc -l | tr -d ' ') files)"
        # clang-tidy (advisory for now): uses the Android compile database if
        # one exists; findings print but do not block.
        cdb=$(ls -d Builds/Android/app/.cxx/*/*/arm64-v8a 2>/dev/null | head -1)
        if [ -x "$TIDY_BIN" ] && [ -n "$cdb" ] && [ -f "$cdb/compile_commands.json" ]; then
            cpps=$(echo "$changed" | grep '\.cpp$' | head -8)
            if [ -n "$cpps" ]; then
                echo "[pre-push] clang-tidy (advisory) on changed sources..."
                # shellcheck disable=SC2086
                "$TIDY_BIN" -p "$cdb" --quiet $cpps 2>/dev/null \
                    | grep -E "warning:|error:" | head -30 || true
            fi
        fi
    fi
else
    echo "[pre-push] clang-format not installed — mechanical checks skipped"
fi

# --- Stage 2: adversarial review -------------------------------------------
if ! command -v claude >/dev/null 2>&1; then
    echo "[pre-push] claude CLI not found — skipping adversarial review"
    exit 0
fi

while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue   # branch deletion: nothing to review
    if [ "$remote_sha" = "$zero" ]; then
        # New remote branch: review what the default branch doesn't have.
        if git rev-parse --verify -q origin/main >/dev/null; then
            range="origin/main..$local_sha"
        else
            range="$local_sha~5..$local_sha"
        fi
    else
        range="$remote_sha..$local_sha"
    fi

    [ -z "$(git rev-list "$range" 2>/dev/null)" ] && continue

    echo "[pre-push] adversarial review of $range ..."
    out=$(claude -p "Use the adversarial-reviewer subagent to review the commit range $range before it is pushed. Follow that agent's instructions and output contract exactly; relay its findings and its final VERDICT line verbatim." \
        --allowedTools "Read,Grep,Glob,Bash(git diff:*),Bash(git log:*),Bash(git show:*),Bash(git rev-list:*)" \
        2>&1)
    echo "$out"

    # Anchor to the LAST verdict-bearing line: findings legitimately quote
    # the contract strings, so a whole-transcript grep is spoofable (the
    # reviewer itself caught this).
    verdict=$(printf '%s\n' "$out" | grep -oE "VERDICT: (PASS|BLOCK)" | tail -n 1)
    if [ "$verdict" = "VERDICT: PASS" ]; then
        echo "[pre-push] review passed for $range"
    else
        echo "[pre-push] BLOCKED: adversarial review did not pass for $range"
        echo "[pre-push] (bypass with SKIP_REVIEW=1 git push)"
        status=1
    fi
done

exit $status
